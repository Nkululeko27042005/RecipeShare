<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title  -  RecipE</title>
    <meta name="description" content="@(ViewBag.Description ?? "RecipE  -  a cookbook of shared flavours.")" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Tailwind (CDN for dev) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        parchment: '#F4EBD9',
                        ink:       '#1E1B16',
                        ember:     '#C4451C',
                        saffron:   '#D9A441',
                        moss:      '#4A5D3A',
                        blush:     '#E8C9B4',
                        smoke:     '#8A8175',
                        cream:     '#FBF6EB'
                    },
                    fontFamily: {
                        display: ['"Playfair Display"', 'serif'],
                        body:    ['"DM Sans"', 'sans-serif'],
                        mono:    ['"DM Mono"', 'monospace']
                    },
                    boxShadow: {
                        'book': '6px 6px 0 0 #1E1B16',
                        'book-sm': '3px 3px 0 0 #1E1B16'
                    }
                }
            }
        }
    </script>

    <!-- Bootstrap (grid + modals) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Site styles -->
    <link href="~/Content/Site.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body class="bg-parchment text-ink font-body antialiased selection:bg-ember selection:text-cream">

    <!-- Anti-forgery token rendered globally so RE.csrf() works on all views -->
    <form id="__AjaxAntiForgeryToken" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- Paper grain overlay -->
    <div class="grain"></div>

    @Html.Partial("_Nav")

    <main class="relative z-10 pt-24 pb-24">
        @RenderBody()
    </main>

    @Html.Partial("_Footer")

    <!-- Toast stack -->
    <div id="toastStack" class="fixed bottom-6 right-6 z-[100] flex flex-col gap-2"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/app.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
