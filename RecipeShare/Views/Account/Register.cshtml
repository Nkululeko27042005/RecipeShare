@{
    Layout = null;
    ViewBag.Title = "Sign up";
    var categories = new[] { "Dessert", "Main Course", "Starter", "Breakfast", "Snack", "Drink", "Vegan", "Baking" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign up  -  RecipE</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@400;500;700&family=DM+Mono&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: { colors: { parchment:'#F4EBD9', ink:'#1E1B16', ember:'#C4451C', saffron:'#D9A441', moss:'#4A5D3A', blush:'#E8C9B4', smoke:'#8A8175', cream:'#FBF6EB' },
            fontFamily:{ display:['"Playfair Display"','serif'], body:['"DM Sans"','sans-serif'], mono:['"DM Mono"','monospace'] },
            boxShadow:{ book:'6px 6px 0 0 #1E1B16', 'book-sm':'3px 3px 0 0 #1E1B16' } } } }
    </script>
</head>
<body class="bg-parchment font-body text-ink min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-xl">
        <a href="/" class="font-display font-black text-4xl inline-block mb-6">Recip<span class="text-ember">E</span></a>

        <div class="bg-cream border-2 border-ink rounded-2xl shadow-book p-8">
            <h1 class="font-display font-bold text-4xl mb-1">Pull up a chair.</h1>
            <p class="text-smoke mb-8">Set up your cookbook in under a minute.</p>

            <form id="registerForm" class="space-y-5">
                @Html.AntiForgeryToken()

                <div class="grid sm:grid-cols-2 gap-4">
                    <label class="block">
                        <span class="font-mono text-xs uppercase tracking-widest text-ember">Display name</span>
                        <input name="DisplayName" required placeholder="Marie"
                               class="mt-1 w-full bg-parchment border-2 border-ink rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ember" />
                    </label>
                    <label class="block">
                        <span class="font-mono text-xs uppercase tracking-widest text-ember">Email</span>
                        <input name="Email" type="email" required placeholder="marie@kitchen.com"
                               class="mt-1 w-full bg-parchment border-2 border-ink rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ember" />
                    </label>
                </div>

                <label class="block">
                    <span class="font-mono text-xs uppercase tracking-widest text-ember">Password</span>
                    <input name="Password" type="password" minlength="6" required placeholder="At least 6 characters"
                           class="mt-1 w-full bg-parchment border-2 border-ink rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ember" />
                </label>

                <fieldset>
                    <legend class="font-mono text-xs uppercase tracking-widest text-ember mb-2">Pick a few favourite categories</legend>
                    <p class="text-xs text-smoke mb-3">We'll use these to recommend dishes you'll actually want to cook.</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var cat in categories)
                        {
                            <label class="cursor-pointer select-none">
                                <input type="checkbox" name="PreferredCategories" value="@cat" class="peer sr-only" />
                                <span class="inline-block px-4 py-1.5 rounded-full border-2 border-ink font-body text-sm bg-parchment
                                             peer-checked:bg-ember peer-checked:text-cream peer-checked:shadow-book-sm transition">
                                    @cat
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>

                <button type="submit" class="w-full bg-ember text-cream font-bold py-3 rounded-lg border-2 border-ink shadow-book hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none transition">
                    Create my cookbook ->
                </button>

                <p id="registerError" class="text-ember text-sm text-center hidden"></p>
            </form>

            <p class="mt-6 text-center text-sm">
                Already have an account?
                <a href="/Account/Login" class="font-bold underline decoration-ember decoration-2 underline-offset-4 hover:text-ember">Sign in</a>
            </p>
        </div>
    </div>

    <script>
    document.getElementById('registerForm').addEventListener('submit', async e => {
        e.preventDefault();
        const form = e.target, btn = form.querySelector('button');
        const preferred = [...form.querySelectorAll('input[name="PreferredCategories"]:checked')].map(i => i.value).join(',');

        btn.disabled = true; btn.textContent = 'Setting the table...';

        const data = {
            DisplayName: form.DisplayName.value,
            Email: form.Email.value,
            Password: form.Password.value,
            PreferredCategoriesCsv: preferred
        };

        const res = await fetch('/Account/Register', {
            method: 'POST',
            body: new URLSearchParams(data),
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            credentials: 'same-origin'
        });
        const json = await res.json();

        if (json.success) {
            location.href = '/Dashboard';
        } else {
            const errEl = document.getElementById('registerError');
            errEl.textContent = Array.isArray(json.errors) ? json.errors.join('  |  ') : (json.errors || 'Registration failed.');
            errEl.classList.remove('hidden');
            btn.disabled = false; btn.textContent = 'Create my cookbook ->';
        }
    });
    </script>
</body>
</html>
