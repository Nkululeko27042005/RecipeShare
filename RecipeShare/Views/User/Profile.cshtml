@{
    ViewBag.Title = "Profile";
    var userId = (string)ViewBag.UserId;
}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8" id="profileApp" data-id="@userId">
    <div id="loader" class="flex justify-center py-32"><div class="spinner"></div></div>
    <div id="content" class="hidden fade-up"></div>
</div>
@section Scripts {
    <script>
(async function () {
    const id = document.getElementById('profileApp').dataset.id;
    const [p, recipes] = await Promise.all([
        fetch(`/User/GetProfile/${id}`, { credentials: 'same-origin' }).then(r => r.json()),
        fetch(`/Recipe/ByUser/${id}`, { credentials: 'same-origin' }).then(r => r.json()).catch(() => [])
    ]);
    if (p.error) { 
        document.getElementById('loader').innerHTML = '<p class="font-mono text-ember">User not found.</p>'; 
        return; 
    }
    document.getElementById('loader').classList.add('hidden');

    document.getElementById('content').innerHTML = `
    <header class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-10">
        <img src="${p.profileImageUrl || 'data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23C4451C\'><circle cx=\'12\' cy=\'8\' r=\'4\'/><path d=\'M20 21a8 8 0 1 0-16 0\'/></svg>'}"
             class="w-28 h-28 rounded-full border-4 border-ink shadow-book object-cover" />
        <div class="flex-1">
            <h1 class="font-display font-black text-4xl">${p.displayName}</h1>
            <p class="text-smoke max-w-xl mt-2">${p.bio || 'No bio yet.'}</p>
            <div class="flex gap-4 font-mono text-xs uppercase tracking-widest mt-3">
                <span><strong class="text-ink">${p.followerCount}</strong> followers</span>
                <span><strong class="text-ink">${p.followingCount}</strong> following</span>
                <span><strong class="text-ink">${p.recipeCount}</strong> recipes</span>
            </div>
        </div>
        <button id="followBtn" class="bg-${p.isFollowedByCurrentUser ? 'moss' : 'ember'} text-cream font-bold px-6 py-3 rounded-full border-2 border-ink shadow-book-sm hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition">
            ${p.isFollowedByCurrentUser ? 'Following' : 'Follow'}
        </button>
    </header>

    <h2 class="font-display font-bold text-2xl rule-doodle inline-block mb-6">Their dishes</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        ${(recipes || []).map(r => `
            <a href="/Recipe/Details/${r.id}" class="recipe-card block bg-cream border-2 border-ink rounded-2xl overflow-hidden shadow-book-sm">
                <div class="aspect-[4/3] bg-blush">
                    <img src="${r.primaryImage || 'data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'400\' height=\'300\' viewBox=\'0 0 400 300\'><rect fill=\'%23E8C9B4\' width=\'400\' height=\'300\'/><text fill=\'%23C4451C\' font-family=\'sans-serif\' font-size=\'20\' font-weight=\'bold\' x=\'50%25\' y=\'50%25\' text-anchor=\'middle\'>Culinary Dish</text></svg>'}" class="w-full h-full object-cover" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'400\' height=\'300\' viewBox=\'0 0 400 300\'><rect fill=\'%23E8C9B4\' width=\'400\' height=\'300\'/><text fill=\'%23C4451C\' font-family=\'sans-serif\' font-size=\'20\' font-weight=\'bold\' x=\'50%25\' y=\'50%25\' text-anchor=\'middle\'>Culinary Dish</text></svg>'" />
                </div>
                <div class="p-4">
                    <div class="tag mb-2">${r.category || 'Dish'}</div>
                    <h3 class="font-display font-bold text-xl">${r.title}</h3>
                </div>
            </a>`).join('') || `<div class="col-span-full text-center font-mono text-smoke py-12 border-2 border-dashed border-ink rounded-xl">No recipes yet.</div>`}
    </div>`;

    document.getElementById('content').classList.remove('hidden');

    const btn = document.getElementById('followBtn');
    btn.onclick = async () => {
        const isFollowing = btn.textContent.trim() === 'Following';
        const r = await RE.post(isFollowing ? '/User/Unfollow' : '/User/Follow', { followeeId: id });
        if (r.success) {
            if (isFollowing) {
                btn.textContent = 'Follow';
                btn.classList.replace('bg-moss', 'bg-ember');
                RE.toast('Unfollowed cook');
            } else {
                btn.textContent = 'Following';
                btn.classList.replace('bg-ember', 'bg-moss');
                RE.toast('Following cook');
            }
        }
    };
})();
    </script>
}
